{
  "name": "the-pet-villa-ipoh",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @pet-villa/web",
    "dev:web": "npm run dev --workspace @pet-villa/web",
    "typecheck": "npm run typecheck --workspaces",
    "test:host-auth": "node scripts/validate-host-auth.mjs",
    "test:staff-access": "node scripts/validate-staff-access.mjs",
    "test:host-orders": "node scripts/validate-host-orders.mjs",
    "test:host-booking-business": "node scripts/validate-host-booking-business.mjs",
    "test:safe-void": "node scripts/validate-safe-void.mjs",
    "test:accounting": "node scripts/validate-business-accounting.mjs",
    "test:host-finance": "node scripts/validate-host-finance.mjs",
    "test:calendar": "node scripts/validate-host-calendar.mjs",
    "test:rules": "node scripts/validate-rules.mjs",
    "test:diary": "node scripts/validate-private-diary.mjs",
    "test:p0-authorization": "node scripts/validate-p0-authorization-order-writes.mjs",
    "test:customer-isolation": "node scripts/validate-customer-data-isolation.mjs",
    "test:customer-auth": "node scripts/validate-customer-auth.mjs",
    "test:public-availability": "node scripts/validate-public-availability.mjs",
    "test:egress": "node scripts/validate-egress-fix.mjs",
    "test:host-ding-dong": "node scripts/validate-host-ding-dong.mjs",
    "test:google-auth": "node scripts/validate-google-social-login.mjs",
    "test:auth-session-storage": "node scripts/validate-auth-session-storage.mjs",
    "test:c1b-payment-cutover": "node scripts/validate-c1b-payment-transaction-cutover.mjs",
    "test:e2e-flow": "node scripts/e2e-flow.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
